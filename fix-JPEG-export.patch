From a8df682863bba1b08295725222c2ff5ca6de96e6 Mon Sep 17 00:00:00 2001
From: Sabri Ünal <yakushabb@gmail.com>
Date: Mon, 4 May 2026 17:04:38 +0300
Subject: [PATCH] Test: Fix JPEG export

Generated using Claude AI to test issue.

Signed-off-by: Sabri Ünal <yakushabb@gmail.com>
---
 src/page.rs | 34 ++++++++++++++++++++++++++++++----
 1 file changed, 30 insertions(+), 4 deletions(-)

diff --git a/src/page.rs b/src/page.rs
index 6c91b29..070716e 100644
--- a/src/page.rs
+++ b/src/page.rs
@@ -496,21 +496,47 @@ impl Page {
             ExportFormat::Svg => svg_bytes,
             ExportFormat::Png | ExportFormat::Jpeg => {
                 // TODO improve resolution
-
                 let loader = gdk_pixbuf::PixbufLoader::new();
                 loader
-                    .write_bytes(&svg_bytes)
-                    .context("Failed to write SVG bytes")?;
+                .write_bytes(&svg_bytes)
+                .context("Failed to write SVG bytes")?;
                 loader.close().context("Failed to close loader")?;
                 let pixbuf = loader.pixbuf().context("Loader has no pixbuf")?;
 
                 let pixbuf_type = match format {
                     ExportFormat::Png => "png",
                     ExportFormat::Jpeg => "jpeg",
                     ExportFormat::Svg => unreachable!(),
                 };
-                let buffer = pixbuf.save_to_bufferv(pixbuf_type, &[])?;
 
+                // JPEG does not support alpha channel; always composite onto white background
+                let pixbuf = if matches!(format, ExportFormat::Jpeg) {
+                    let width = pixbuf.width();
+                    let height = pixbuf.height();
+                    let white_bg = gdk_pixbuf::Pixbuf::new(
+                        gdk_pixbuf::Colorspace::Rgb,
+                        false, // no alpha
+                        8,
+                        width,
+                        height,
+                    )
+                    .context("Failed to create white background pixbuf")?;
+                    white_bg.fill(0xffffffff); // RGBA: white, fully opaque
+                    pixbuf.composite(
+                        &white_bg,
+                        0, 0,           // dest x, y
+                        width, height,  // dest width, height
+                        0.0, 0.0,       // offset x, y
+                        1.0, 1.0,       // scale x, y
+                        gdk_pixbuf::InterpType::Bilinear,
+                        255,            // overall alpha (fully opaque)
+                    );
+                    white_bg
+                } else {
+                    pixbuf
+                };
+
+                let buffer = pixbuf.save_to_bufferv(pixbuf_type, &[])?;
                 glib::Bytes::from_owned(buffer)
             }
         };
